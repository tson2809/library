@model List<Client_web.Models.ViewModels.OverdueLoanVm>
@{
    ViewData["Title"] = "Danh sách quá hạn";
}

<div class="manager-shell">
    <partial name="~/Views/Shared/_ManagerSidebar.cshtml" />

    <section class="manager-content">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">Danh sách sách quá hạn</h3>
            <div class="d-flex gap-2">
                <a asp-action="ExportOverdueExcel" class="btn btn-outline-primary">Xuất Excel</a>
                <a asp-action="OverdueLoansPrint" class="btn btn-dark" target="_blank">In danh sách</a>
            </div>
        </div>

        <partial name="~/Views/Shared/_FlashMessages.cshtml" />

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <div class="table-wrap">
            <table class="table table-striped align-middle mb-0" id="overdueTable">
                <thead>
                    <tr>
                        <th>Phiếu</th>
                        <th>Thành viên</th>
                        <th>Ngày mượn</th>
                        <th>Hạn trả</th>
                        <th>Trễ (ngày)</th>
                        <th>Số cuốn</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="7" class="text-muted">Không có phiếu quá hạn.</td></tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr class="@(item.DaysOverdue > 15 ? "table-danger" : "")" data-paginate="overdue">
                                <td>#@item.LoanId</td>
                                <td>@item.Member</td>
                                <td>@item.LoanDate.ToString("dd/MM/yyyy")</td>
                                <td>@item.DueDate.ToString("dd/MM/yyyy")</td>
                                <td><span class="fw-semibold text-danger">@item.DaysOverdue</span></td>
                                <td>@item.ItemCount</td>
                                <td>@item.Status</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <div class="catalog-footer mt-3">
                <div class="catalog-pager" id="overduePager"></div>
                <div class="catalog-page-size">
                    <label for="overduePageSize" class="form-label mb-0">Hiển thị</label>
                    <select id="overduePageSize" class="form-select form-select-sm">
                        <option value="5" selected>5</option>
                        <option value="10">10</option>
                        <option value="20">20</option>
                    </select>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        (() => {
            const rows = Array.from(document.querySelectorAll('tr[data-paginate="overdue"]'));
            const pager = document.getElementById('overduePager');
            const pageSizeSelect = document.getElementById('overduePageSize');
            if (!rows.length || !(pager instanceof HTMLElement) || !(pageSizeSelect instanceof HTMLSelectElement)) return;

            let currentPage = 1;
            let pageSize = Number.parseInt(pageSizeSelect.value, 10) || 5;

            const render = () => {
                rows.forEach(r => r.style.display = 'none');
                const totalPages = Math.max(1, Math.ceil(rows.length / pageSize));
                if (currentPage > totalPages) currentPage = totalPages;
                const start = (currentPage - 1) * pageSize;
                rows.slice(start, start + pageSize).forEach(r => r.style.display = '');
                window.renderPagination({
                    pager,
                    totalPages,
                    currentPage,
                    onPageChange: page => {
                        currentPage = page;
                        render();
                    }
                });
            };

            pageSizeSelect.addEventListener('change', () => {
                pageSize = Number.parseInt(pageSizeSelect.value, 10) || 10;
                currentPage = 1;
                render();
            });

            render();
        })();
    </script>
}
